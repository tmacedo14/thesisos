# Existing providers
FINNHUB_API_KEY=
OPENFIGI_API_KEY=
EODHD_API_TOKEN=
SEC_USER_AGENT=ThesisOS your-email@example.com

# Optional secure Cloud Sync
SUPABASE_URL=https://your-project.supabase.co
# Prefer the current server-side secret key. Never expose it in index.html.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative, used only when SUPABASE_SECRET_KEY is absent:
# SUPABASE_SERVICE_ROLE_KEY=
THESISOS_SYNC_PASSWORD=choose-a-long-unique-password
THESISOS_WORKSPACE_ID=primary
# Use 1 on an HTTPS deployment such as Replit; use 0 for local http development.
THESISOS_COOKIE_SECURE=1

# Supabase Auth (safe/public client key, stored here for deployment configuration)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Keep the next two only while importing the legacy workspace.
THESISOS_SYNC_PASSWORD=replace_for_legacy_migration
THESISOS_WORKSPACE_ID=tiago
