# Fornecedores de dados
FINNHUB_API_KEY=
OPENFIGI_API_KEY=
EODHD_API_TOKEN=
LOGOKIT_PUBLISHABLE_TOKEN=
SEC_USER_AGENT=ThesisOS Alpha contact@example.com

# Supabase Auth e persistência por utilizador
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Compatibilidade opcional com projetos Supabase antigos:
# SUPABASE_ANON_KEY=

# Testes autenticados opcionais
# Usar apenas com: python3 test_supabase_auth.py --login
THESISOS_TEST_EMAIL=
THESISOS_TEST_PASSWORD=

# AI Investment Brief Beta — desativado por defeito
THESISOS_AI_BRIEF_ENABLED=false
# Provider suportado atualmente: openai
THESISOS_AI_BRIEF_PROVIDER=
THESISOS_AI_BRIEF_MODEL=
THESISOS_AI_BRIEF_API_KEY=
# Groq experimental/manual smoke; runtime ainda não ligado
THESISOS_AI_BRIEF_GROQ_API_KEY=
THESISOS_AI_BRIEF_TIMEOUT_SECONDS=20

# Cache e observabilidade do AI Investment Brief
THESISOS_AI_BRIEF_CACHE_ENABLED=true
THESISOS_AI_BRIEF_CACHE_TTL_SECONDS=900
THESISOS_AI_BRIEF_CACHE_MAX_ENTRIES=128
THESISOS_AI_BRIEF_LOG_EVENTS=false
