{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thesisos:contract:ai-investment-brief-grounding:1.0",
  "title": "ThesisOS AI Investment Brief Grounding Bundle",
  "description": "Deterministic, whitelisted model input prepared from a ThesisOS analysis payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "source",
    "asset",
    "analysis_generated_at",
    "coverage",
    "source_types",
    "evidence_refs",
    "grounded_data",
    "payload_sha256"
  ],
  "properties": {
    "bundle_version": {
      "const": "1.0"
    },
    "source": {
      "const": "thesisos"
    },
    "asset": {
      "$ref": "#/$defs/asset"
    },
    "analysis_generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "source_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_type"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "grounded_data": {
      "$ref": "#/$defs/grounded_data"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "asset_type",
        "isin",
        "exchange",
        "currency"
      ],
      "properties": {
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "stock",
            "etf",
            "commodity",
            "fund",
            "bond",
            "crypto",
            "other"
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "exchange": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "data_completeness_pct",
        "uncertainty_level",
        "missing_critical_fields",
        "missing_optional_fields"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "partial",
            "insufficient_data"
          ]
        },
        "data_completeness_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "uncertainty_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "missing_critical_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_optional_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official_filing",
        "official_fund_document",
        "company_release",
        "market_data",
        "technical_data",
        "portfolio_state",
        "thesisos_engine",
        "other"
      ]
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "title",
        "source_url",
        "as_of",
        "field_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "$ref": "#/$defs/source_type"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "grounded_data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fundamentals": {},
        "framework": {},
        "valuation": {},
        "technical": {},
        "evidence": {},
        "portfolio": {},
        "market_context": {}
      }
    }
  }
}
